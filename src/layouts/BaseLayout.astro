---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Footer from '../components/Footer.astro';
import resume from '../data/resume.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${resume.basics.name} — Full-Stack Developer Portfolio`,
  description = resume.basics.summary,
} = Astro.props;

const resumeUrl = resume.basics.resumeUrl || "https://github.com/Zafff-e/Resume_CV/raw/main/resume.pdf";
---
<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Dark Mode Class Strategy: Default to dark, preserve theme preference -->
    <script is:inline>
      (function () {
        var savedTheme = null;
        try {
          savedTheme = localStorage.getItem('theme');
        } catch (e) {}
        // Default to dark mode aesthetic
        var isDark = savedTheme ? savedTheme === 'dark' : true;
        document.documentElement.classList.toggle('dark', isDark);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-slate-950 text-slate-300 font-sans antialiased selection:bg-cyan-500 selection:text-slate-950">
    <!-- Sticky Glassmorphism Navigation Bar -->
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
        <a href="#top" class="group flex items-center gap-2 font-bold text-white transition hover:text-cyan-400">
          <span class="flex size-8 items-center justify-center rounded-lg bg-cyan-500/10 text-xs font-extrabold text-cyan-400 ring-1 ring-cyan-500/30 group-hover:bg-cyan-500/20">
            ZH
          </span>
          <span class="tracking-tight">
            Zafir<span class="text-cyan-400">.Hasan</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <div class="flex items-center gap-5 sm:gap-6">
          <a
            href="#experience"
            class="text-sm font-medium text-slate-300 transition hover:text-cyan-400"
          >
            Experience
          </a>
          <a
            href="#projects"
            class="text-sm font-medium text-slate-300 transition hover:text-cyan-400"
          >
            Projects
          </a>
          <a
            href={resumeUrl}
            download="AHM_Zafir_Hasan_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-lg bg-cyan-500 px-3.5 py-1.5 text-xs sm:text-sm font-semibold text-slate-950 shadow-sm transition hover:bg-cyan-400 hover:shadow-cyan-500/20"
          >
            <span>Resume</span>
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </a>
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <!-- Main Wrapper -->
    <main id="top" class="flex-1 mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <!-- Footer Component pinned to bottom -->
    <Footer />
  </body>
</html>

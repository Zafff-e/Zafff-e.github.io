---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import resume from '../data/resume.json';

interface Props { title?: string }
const { title = `${resume.basics.name} — ${resume.basics.title}` } = Astro.props;
const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={resume.basics.summary} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Set theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="bg-white font-sans text-slate-700 antialiased dark:bg-slate-950 dark:text-slate-300">
    <header class="sticky top-0 z-10 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
        <a href="#top" class="font-semibold text-slate-900 dark:text-white">{resume.basics.name}</a>
        <div class="flex items-center gap-4 text-sm sm:gap-6">
          {links.map((l) => (
            <a href={l.href} class="hidden hover:text-indigo-600 sm:inline dark:hover:text-indigo-400">{l.label}</a>
          ))}
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main id="top" class="mx-auto max-w-5xl px-4 sm:px-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl px-4 py-10 text-center text-sm text-slate-500 sm:px-6">
      © {new Date().getFullYear()} {resume.basics.name}
    </footer>
  </body>
</html>

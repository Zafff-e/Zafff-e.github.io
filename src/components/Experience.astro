---
import resume from '../data/resume.json';
const { experience, education } = resume;
---
<section id="experience" class="scroll-mt-16 py-12">
  <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Experience</h2>
  <ol class="mt-8 space-y-8 border-l-2 border-slate-200 pl-6 dark:border-slate-800">
    {experience.map((job) => (
      <li class="relative">
        <span class="absolute -left-[31px] top-1.5 size-3 rounded-full bg-indigo-600 ring-4 ring-white dark:ring-slate-950"></span>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{job.period}</p>
        <h3 class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">{job.role}</h3>
        <p class="text-indigo-600 dark:text-indigo-400">{job.company}</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          {job.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </li>
    ))}
  </ol>
  <h3 class="mt-14 text-xl font-bold text-slate-900 dark:text-white">Education</h3>
  <ul class="mt-4 space-y-3">
    {education.map((e) => (
      <li class="flex flex-col justify-between gap-1 sm:flex-row">
        <span><strong class="text-slate-900 dark:text-white">{e.degree}</strong> — {e.school}</span>
        <span class="text-sm text-slate-500">{e.period}</span>
      </li>
    ))}
  </ul>
</section>

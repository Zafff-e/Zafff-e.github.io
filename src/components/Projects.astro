---
import resume from '../data/resume.json';
const { projects } = resume;
---
<section id="projects" class="scroll-mt-16 py-12">
  <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Projects</h2>
  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => (
      <article class="flex flex-col rounded-xl border border-slate-200 p-5 transition hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:hover:shadow-indigo-500/10">
        <div class="flex items-start justify-between gap-2">
          <h3 class="font-semibold text-slate-900 dark:text-white">
            {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400">{p.name} ↗</a> : p.name}
          </h3>
          <span class:list={['shrink-0 rounded-full px-2 py-0.5 text-xs font-medium',
            p.status === 'Completed' ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300' : 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300']}>{p.status}</span>
        </div>
        <p class="mt-3 flex-1 text-sm leading-relaxed">{p.description}</p>
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {p.tech.map((t) => <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-300">{t}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>

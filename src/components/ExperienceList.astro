---
interface ExperienceItem {
  period: string;
  role: string;
  institution: string;
  location: string;
  type: string;
  traineeId?: string;
  summary: string;
  highlights: string[];
  skills: string[];
}

const experiences: ExperienceItem[] = [
  {
    period: 'Jan 2026 – Oct 2026',
    role: 'Enterprise Software Engineering Trainee (WADA / ESAD-CS)',
    institution: 'IsDB-BISEW IT Scholarship Programme | Star Computer Systems Limited',
    location: 'Dhaka, Bangladesh',
    type: 'Full-Time Professional Diploma',
    traineeId: '1294926 (Round 70)',
    summary: 'Completed prestigious, fully funded 9-month enterprise software engineering fellowship (1,000+ hours). Served as backend and database lead for capstone multi-tier platform development.',
    highlights: [
      'Completed rigorous training in Database Design & Implementation (MS SQL Server, T-SQL, Stored Procs, TVPs), C# OOP, and ASP.NET Core Web APIs (.NET 9).',
      'Architected 8+ multi-tier enterprise systems incorporating Entity Framework Core Code-First/DB-First migrations, DTOs, and JWT token authentication.',
      'Served as backend and database lead on the capstone Skill-Commerce hyperlocal skilled-worker marketplace platform.'
    ],
    skills: ['C#', 'ASP.NET Core (.NET 9)', 'EF Core', 'SQL Server', 'Angular', 'React 19', 'Azure', 'REST APIs']
  },
  {
    period: '2021 – 2022',
    role: 'Management Trainee Officer',
    institution: 'Marico Bangladesh Limited',
    location: 'Dhaka, Bangladesh',
    type: 'Corporate Operations & Analytics',
    summary: 'Analyzed business KPIs, market trends, and product performance data across regional distribution networks.',
    highlights: [
      'Aggregated and analyzed complex distribution data across regional networks to identify growth trends and operational bottlenecks.',
      'Collaborated with cross-functional commercial teams to evaluate structured market research and present actionable insights.',
      'Streamlined data collection procedures, reducing reporting discrepancies across regional teams.'
    ],
    skills: ['Quantitative Analysis', 'KPI Modeling', 'Commercial Strategy', 'Cross-Functional Collaboration']
  },
  {
    period: 'Prior Experience',
    role: 'IT Workshop Coordinator / ICT Instructor',
    institution: 'Freelance / Community Initiatives',
    location: 'Dhaka, Bangladesh',
    type: 'Technical Mentorship & Teaching',
    summary: 'Instructed students and trainees in computer fundamentals, digital literacy, and database logic.',
    highlights: [
      'Mentored students on computer fundamentals, relational database logic, and productivity tools.',
      'Conducted practical hands-on workshops in software workflows and structured data management.',
      'Guided trainees through problem-solving exercises and core IT foundations.'
    ],
    skills: ['Database Logic', 'Technical Instruction', 'Computer Fundamentals', 'Mentorship']
  }
];
---
<section id="experience" class="scroll-mt-20 py-12 border-b border-slate-800/80">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400 mb-1.5">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Career Dossier &bull; Work History
    </div>
    <h2 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">
      Professional Experience &amp; IT Fellowship
    </h2>
    <p class="mt-2 text-sm text-slate-400 max-w-2xl">
      A chronological record of enterprise software development training, backend leadership, and corporate analytical track.
    </p>
  </div>

  <!-- HugoBlox Academic CV Timeline -->
  <div class="relative border-l-2 border-slate-800 ml-3 sm:ml-4 space-y-12 pl-6 sm:pl-8">
    {experiences.map((exp) => (
      <div class="relative group">
        <!-- Circular Node -->
        <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 size-3.5 rounded-full border-2 border-slate-950 bg-cyan-400 ring-4 ring-slate-900"></div>

        <!-- Period & Type Header -->
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="inline-flex items-center rounded-md border border-cyan-500/30 bg-cyan-500/10 px-2.5 py-0.5 text-xs font-mono font-semibold text-cyan-300">
            {exp.period}
          </span>
          <span class="text-xs font-mono text-slate-400">
            &bull; {exp.type}
          </span>
          {exp.traineeId && (
            <span class="rounded bg-slate-900 border border-slate-800 px-2 py-0.5 text-[11px] font-mono text-slate-400">
              ID: {exp.traineeId}
            </span>
          )}
        </div>

        <!-- Role & Institution -->
        <h3 class="text-lg sm:text-xl font-display font-bold text-white group-hover:text-cyan-300 transition-colors">
          {exp.role}
        </h3>
        <p class="text-sm font-medium text-slate-300 mt-0.5">
          {exp.institution} <span class="text-slate-500 font-normal">({exp.location})</span>
        </p>

        <!-- Summary -->
        <p class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed max-w-3xl">
          {exp.summary}
        </p>

        <!-- Highlights Bullet List -->
        <ul class="mt-3.5 space-y-2 text-xs sm:text-sm text-slate-300 list-none pl-0 max-w-3xl">
          {exp.highlights.map((h) => (
            <li class="flex items-start gap-2">
              <span class="text-cyan-400 mt-0.5 shrink-0 text-xs font-mono">&gt;</span>
              <span class="leading-relaxed">{h}</span>
            </li>
          ))}
        </ul>

        <!-- Skills / Tech Stack Chips -->
        <div class="mt-4 flex flex-wrap gap-1.5 pt-2">
          {exp.skills.map((skill) => (
            <span class="rounded-md border border-slate-800/80 bg-slate-900/80 px-2.5 py-0.5 text-[10px] font-mono text-slate-300">
              {skill}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

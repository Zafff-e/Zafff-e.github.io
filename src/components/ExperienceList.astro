---
import resume from '../data/resume.json';

const { experience, education } = resume;
---
<section id="experience" class="scroll-mt-24 py-16">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Career Journey
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
      Work & Scholarship Experience
    </h2>
    <p class="mt-2 text-base text-slate-400 max-w-2xl">
      Hands-on software engineering training, enterprise systems analysis, and technical leadership track.
    </p>
  </div>

  <!-- Vertical Timeline Layout with border-l-2 border-slate-700 -->
  <div class="relative ml-3 border-l-2 border-slate-700 space-y-12 pl-6 sm:pl-8">
    {experience.map((item) => (
      <div class="relative group">
        <!-- Small circular indicator node at the start of each job entry -->
        <span class="absolute -left-[31px] sm:-left-[39px] top-1.5 size-3.5 rounded-full border-2 border-slate-950 bg-cyan-400 ring-4 ring-slate-900 group-hover:scale-125 group-hover:bg-cyan-300 transition-all duration-200"></span>

        <!-- Date Range -->
        <span class="inline-block text-xs font-semibold uppercase tracking-wider text-cyan-400">
          {item.period}
        </span>

        <!-- Job / Scholarship Title -->
        <h3 class="mt-1 text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
          {item.role}
        </h3>

        <!-- Company / Organization -->
        <p class="text-sm font-medium text-slate-300 mt-0.5">
          {item.company}
        </p>

        <!-- Brief unordered list of responsibilities with high contrast -->
        <ul class="mt-4 list-disc space-y-2 pl-5 text-sm text-slate-300 leading-relaxed marker:text-slate-500">
          {item.highlights.map((resp) => (
            <li>{resp}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <!-- Education Timeline / Credentials -->
  {education && education.length > 0 && (
    <div class="mt-16 pt-12 border-t border-slate-800">
      <h3 class="text-xl font-bold text-white mb-6">
        Education & Scholarship Qualifications
      </h3>
      <div class="grid gap-4 sm:grid-cols-2">
        {education.map((edu) => (
          <div class="rounded-xl border border-slate-800/80 bg-slate-900/50 p-5">
            <span class="text-xs font-semibold text-cyan-400">{edu.period}</span>
            <h4 class="mt-1 font-bold text-white text-base">{edu.degree}</h4>
            <p class="text-sm text-slate-300">{edu.school}</p>
            {edu.highlights && edu.highlights.length > 0 && (
              <p class="mt-2 text-xs text-slate-400">{edu.highlights[0]}</p>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</section>

---
<section id="projects" class="scroll-mt-20 py-12 border-b border-slate-800/80">
  <div class="mb-8">
    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400 mb-1.5">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Engineering Works &bull; Software Systems
    </div>
    <h2 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">
      Featured Projects &amp; System Architectures
    </h2>
    <p class="mt-2 text-sm text-slate-400 max-w-2xl">
      A curated portfolio of full-stack web applications, RESTful microservices, normalized relational schemas, and team capstone platforms.
    </p>

    <!-- HugoBlox Filter Tabs -->
    <div class="mt-6 flex flex-wrap gap-2 text-xs font-medium" id="project-filters">
      <button
        type="button"
        data-filter="all"
        class="filter-btn active rounded-lg border border-cyan-500/50 bg-cyan-500/15 px-3 py-1.5 text-cyan-300 font-semibold transition"
      >
        All Works ({projects.length})
      </button>
      <button
        type="button"
        data-filter="dotnet"
        class="filter-btn rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-1.5 text-slate-400 hover:border-slate-700 hover:text-white transition"
      >
        .NET &amp; C# (4)
      </button>
      <button
        type="button"
        data-filter="nodejs"
        class="filter-btn rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-1.5 text-slate-400 hover:border-slate-700 hover:text-white transition"
      >
        Node.js &amp; MongoDB (1)
      </button>
      <button
        type="button"
        data-filter="database"
        class="filter-btn rounded-lg border border-slate-800 bg-slate-900/60 px-3 py-1.5 text-slate-400 hover:border-slate-700 hover:text-white transition"
      >
        Database Architecture (1)
      </button>
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-container">
    {projects.map((project) => (
      <article
        data-category={project.category}
        class="project-card group flex flex-col justify-between rounded-2xl border border-slate-800 bg-slate-900 p-6 transition-colors duration-150 hover:border-slate-700 relative overflow-hidden"
      >

        <div>
          <!-- Header: Category Badge & GitHub Link -->
          <div class="flex items-center justify-between gap-2 mb-3">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-800 bg-slate-950 px-2.5 py-0.5 text-[11px] font-mono font-medium text-cyan-400">
              <span class="size-1 rounded-full bg-cyan-400"></span>
              {project.badge}
            </span>

            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${project.title} repository on GitHub`}
              class="flex items-center gap-1 text-xs font-mono font-medium text-slate-400 hover:text-cyan-400 transition"
              title="View on GitHub"
            >
              <span>Code</span>
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>

          <!-- Project Title -->
          <h3 class="text-base sm:text-lg font-display font-bold text-white group-hover:text-cyan-300 transition-colors">
            <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
              {project.title}
            </a>
          </h3>

          <!-- Subtitle / Role Tag -->
          <p class="mt-1 text-xs font-mono text-cyan-400/90 font-medium">
            {project.role} &bull; {project.shortDescription}
          </p>

          <!-- Descriptive Body -->
          <p class="mt-3 text-xs sm:text-sm text-slate-300 leading-relaxed">
            {project.description}
          </p>

          <!-- Key Engineering Accomplishments -->
          <div class="mt-4 space-y-1.5 border-t border-slate-800/80 pt-3.5">
            <span class="text-[10px] font-mono uppercase text-slate-400 tracking-wider block">
              Architectural Highlights:
            </span>
            <ul class="space-y-1 text-xs text-slate-300">
              {project.highlights.map((h) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-cyan-400 mt-0.5 shrink-0">✓</span>
                  <span class="leading-tight">{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Tech Tags at Bottom -->
        <div class="mt-6 border-t border-slate-800/80 pt-4">
          <div class="flex flex-wrap gap-1.5">
            {project.tags.map((tag) => (
              <span class="rounded-md border border-slate-800 bg-slate-950/80 px-2 py-0.5 text-[10px] font-mono text-slate-300">
                {tag}
              </span>
            ))}
          </div>

          <!-- Direct GitHub Link Button -->
          <div class="mt-4 pt-3 flex items-center justify-between">
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-1.5 rounded-lg border border-slate-800 bg-slate-950/60 py-1.5 text-xs font-medium text-slate-300 hover:border-cyan-500/40 hover:bg-slate-800 hover:text-white transition"
            >
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
              <span>Repository &amp; Specs ↗</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<!-- Filter Script -->
<script is:inline>
  const filterBtns = document.querySelectorAll('#project-filters .filter-btn');
  const cards = document.querySelectorAll('#projects-container .project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('active', 'border-cyan-500/50', 'bg-cyan-500/15', 'text-cyan-300', 'font-semibold');
        b.classList.add('border-slate-800', 'bg-slate-900/60', 'text-slate-400');
      });

      btn.classList.add('active', 'border-cyan-500/50', 'bg-cyan-500/15', 'text-cyan-300', 'font-semibold');
      btn.classList.remove('border-slate-800', 'bg-slate-900/60', 'text-slate-400');

      const filter = btn.getAttribute('data-filter');

      cards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>

---
interface Project {
  title: string;
  shortDescription: string;
  description?: string;
  tags: string[];
  githubUrl: string;
}

const projects: Project[] = [
  {
    title: 'TechNova E-Commerce',
    shortDescription: 'Automated workflow orchestration & real-time hardware store',
    description: 'Modular backend featuring REST endpoints for auth, catalog, cart, and order processing with WebSockets live inventory updates and MongoDB.',
    tags: ['Node.js', 'Express.js', 'MongoDB', 'WebSockets', 'bcrypt'],
    githubUrl: 'https://github.com/Zafff-e',
  },
  {
    title: 'Supply Chain & Product Catalog',
    shortDescription: 'Web API service with EF Core & role-based authentication',
    description: 'Enterprise RESTful Web API handling normalized Category-Product-Brand master-detail CRUD operations, migrations, and DTO contracts.',
    tags: ['C#', 'ASP.NET Core', 'EF Core', 'SQL Server', 'REST API'],
    githubUrl: 'https://github.com/Zafff-e/AspNetCore-ProductCatalog-MVC',
  },
  {
    title: 'Power Plant Operations Database',
    shortDescription: 'Industrial 3NF relational database architecture',
    description: 'Normalized relational schema modeling monthly power generation metrics, fuel consumption, and plant performance converted from industrial records.',
    tags: ['SQL Server', 'T-SQL', 'Relational Design', 'Stored Procedures'],
    githubUrl: 'https://github.com/Zafff-e/-Power-Plant-Operations-Reporting-Database.',
  },
  {
    title: 'Enterprise Master-Detail Platform',
    shortDescription: 'Web API service with TVP and stored procedures',
    description: 'Database-First master-detail enterprise system utilizing Table-Valued Parameters (TVP), image streaming, aggregations, and pagination.',
    tags: ['ASP.NET Core 9', 'SQL Server', 'TVP', 'EF Core', 'Stored Procs'],
    githubUrl: 'https://github.com/Zafff-e/AspNetCore-DatabaseFirst-StoredProcedure-CRUD',
  },
  {
    title: 'Skill-Commerce Marketplace',
    shortDescription: 'Automated workflow orchestration for skilled worker booking',
    description: 'Hyperlocal service marketplace capstone with RESTful APIs, booking flows, provider profiles, and Git team sprint coordination.',
    tags: ['C#', 'ASP.NET Core', 'Angular', 'React', 'Azure'],
    githubUrl: 'https://github.com/Zafff-e',
  },
  {
    title: 'MVC5 Code-First CRUD System',
    shortDescription: 'Web API service and transactional master-detail platform',
    description: 'Master-detail data platform with Code-First migrations, referential integrity, and responsive management interfaces.',
    tags: ['ASP.NET MVC 5', 'Entity Framework', 'C#', 'Bootstrap'],
    githubUrl: 'https://github.com/Zafff-e/MVC5-CodeFirst-CRUD-WebApp',
  },
];
---
<section id="projects" class="scroll-mt-24 py-16">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-cyan-400 mb-2">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Portfolio
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
      Featured Projects
    </h2>
    <p class="mt-2 text-base text-slate-400 max-w-2xl">
      A showcase of web applications, REST APIs, database architectures, and full-stack solutions.
    </p>
  </div>

  <!-- Projects Grid: grid-cols-1 md:grid-cols-2 lg:grid-cols-3 -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <article class="group flex flex-col justify-between rounded-xl border border-slate-800 bg-slate-900 p-6 transition-all duration-300 ease-out hover:-translate-y-1 hover:border-slate-700 hover:shadow-lg hover:shadow-cyan-900/20">
        <div>
          <!-- Header with Project Title and GitHub Icon Link -->
          <div class="flex items-start justify-between gap-3">
            <h3 class="text-lg font-bold text-white transition-colors group-hover:text-cyan-400">
              <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
                {project.title}
              </a>
            </h3>

            <!-- GitHub Repository Icon Link -->
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${project.title} on GitHub`}
              class="shrink-0 text-slate-400 hover:text-white transition-colors p-1"
            >
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
          </div>

          <!-- Short Description Tagline -->
          <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-cyan-400/90">
            {project.shortDescription}
          </p>

          <!-- Descriptive Body -->
          {project.description && (
            <p class="mt-3 text-sm text-slate-300 leading-relaxed">
              {project.description}
            </p>
          )}
        </div>

        <!-- Row of small tech tags at the bottom -->
        <div class="mt-6 flex flex-wrap gap-1.5 pt-4 border-t border-slate-800/80">
          {project.tags.map((tag) => (
            <span class="rounded-md bg-slate-800 px-2 py-0.5 text-xs font-medium text-slate-300 border border-slate-700/50">
              {tag}
            </span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>

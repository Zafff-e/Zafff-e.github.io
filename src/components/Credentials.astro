---
const credentials = [
  {
    category: 'Prestigious IT Fellowship',
    badge: 'Fully Funded Scholarship',
    title: 'Professional Diploma in Enterprise Systems Development (C# .NET)',
    institution: 'IsDB-BISEW IT Scholarship Programme &bull; Star Computer Systems Limited',
    period: 'Jan 2026 – Present (Round 70 &bull; Trainee ID: 1294926)',
    highlights: [
      'Competitive national selection for intensive full-time enterprise software engineering fellowship.',
      'Completed 1,000+ hours of advanced development in C#, ASP.NET Core (.NET 9), SQL Server, EF Core, Angular, and Azure.',
      'Selected as backend and database lead on team capstone project.'
    ]
  },
  {
    category: 'University Degree',
    badge: 'Honours Degree',
    title: 'Bachelor of Social Sciences (B.S.S. Hons) in Economics',
    institution: 'University of Dhaka (DU), Bangladesh',
    period: '2014 – 2019',
    highlights: [
      'Comprehensive coursework in Econometrics, Mathematical Statistics, and Quantitative Data Modeling.',
      'Developed analytical frameworks directly applied to relational data structures, 3NF schema design, and operational metrics.'
    ]
  },
  {
    category: 'Language Certification',
    badge: 'CEFR Level C1',
    title: 'IELTS English Language Proficiency &mdash; Band 7.5',
    institution: 'IDP / British Council',
    period: 'Proficient User Certification',
    highlights: [
      'Validated English fluency across Listening, Reading, Writing, and Speaking.',
      'Equipped for international engineering teams, remote collaboration, and technical documentation.'
    ]
  },
  {
    category: 'Higher Secondary Education',
    badge: 'Science',
    title: 'Higher Secondary Certificate (HSC)',
    institution: 'Cantonment Public School & College, Rangpur (CPSCR)',
    period: '2011 – 2013',
    highlights: [
      'Completed secondary education with focused coursework in Mathematics, Physics, and Chemistry.'
    ]
  }
];
---
<section id="credentials" class="scroll-mt-20 py-12 border-b border-slate-800/80">
  <div class="mb-10">
    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400 mb-1.5">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Academic Track &bull; Qualifications
    </div>
    <h2 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">
      Education, Honors &amp; Certifications
    </h2>
    <p class="mt-2 text-sm text-slate-400 max-w-2xl">
      Official academic degrees, competitive scholarship awards, and international language certifications.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {credentials.map((item) => (
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:border-slate-700 hover:bg-slate-900/80 backdrop-blur-xs flex flex-col justify-between">
        <div>
          <!-- Header Category & Badge -->
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs font-mono text-cyan-400 font-semibold">
              {item.category}
            </span>
            <span class="rounded-full border border-slate-800 bg-slate-950 px-2.5 py-0.5 text-[10px] font-mono text-slate-400">
              {item.badge}
            </span>
          </div>

          <!-- Title & Institution -->
          <h3 class="text-base sm:text-lg font-display font-bold text-white mt-1">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm font-medium text-slate-300 mt-1" set:html={item.institution} />
          <p class="text-xs font-mono text-slate-400 mt-1" set:html={item.period} />

          <!-- Highlights -->
          <ul class="mt-4 space-y-1.5 text-xs text-slate-300">
            {item.highlights.map((h) => (
              <li class="flex items-start gap-2">
                <span class="text-cyan-400 mt-0.5 shrink-0 text-xs font-mono">&bull;</span>
                <span class="leading-relaxed">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>

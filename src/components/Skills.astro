---
import resume from '../data/resume.json';
---
<section id="skills" class="scroll-mt-16 py-12">
  <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Skills</h2>
  <dl class="mt-8 space-y-5">
    {resume.skills.map((g) => (
      <div class="grid gap-2 sm:grid-cols-[12rem_1fr]">
        <dt class="font-medium text-slate-900 dark:text-white">{g.category}</dt>
        <dd class="flex flex-wrap gap-2">
          {g.items.map((s) => <span class="rounded-full border border-slate-200 px-3 py-1 text-sm dark:border-slate-700">{s}</span>)}
        </dd>
      </div>
    ))}
  </dl>
</section>

---
import resume from '../data/resume.json';

const { email, name } = resume.basics;
const resumeUrl = "/resume.pdf";
---
<footer id="contact" class="mt-auto w-full border-t border-slate-800 bg-slate-950/90 py-16 px-4 text-center sm:px-6 backdrop-blur-md">
  <div class="mx-auto max-w-2xl flex flex-col items-center">
    <!-- Section Identifier -->
    <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400 mb-2">
      <span class="size-1.5 rounded-full bg-cyan-400"></span>
      Academic &amp; Professional Collaboration
    </div>

    <!-- Get In Touch Heading -->
    <h2 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight text-white">
      Let's Build Impactful Software Together
    </h2>

    <p class="mt-3 text-sm text-slate-400 max-w-lg leading-relaxed">
      Whether you have a full-time software engineering opening, a backend consulting inquiry, or a team collaboration, my inbox is always open.
    </p>

    <!-- Prominent Contact CTAs -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 px-6 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-cyan-500/20 transition-all duration-200 hover:from-cyan-400 hover:to-blue-500 hover:shadow-cyan-500/40 hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Send Email ({email})</span>
      </a>

      <a
        href={resumeUrl}
        download="AHM_Zafir_Hasan_Resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900/80 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-slate-600 hover:bg-slate-800 hover:text-white"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download CV (PDF)</span>
      </a>
    </div>

    <!-- Academic & Social Badges -->
    <div class="mt-8 flex items-center justify-center gap-3">
      <!-- GitHub -->
      <a
        href="https://github.com/Zafff-e"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="flex size-10 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 transition hover:border-cyan-500/50 hover:bg-slate-800 hover:text-white"
        title="GitHub: github.com/Zafff-e"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/zafir-hasan-developer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="flex size-10 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/60 text-slate-400 transition hover:border-cyan-500/50 hover:bg-slate-800 hover:text-white"
        title="LinkedIn: in/zafir-hasan-developer"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.761-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
        </svg>
      </a>
    </div>

    <!-- Scholarly Citation & Credits -->
    <div class="mt-10 border-t border-slate-800/80 pt-6 text-xs text-slate-400 space-y-1">
      <p>
        © {new Date().getFullYear()} <span class="text-slate-300 font-semibold">{name}</span>. All rights reserved.
      </p>
      <p class="text-[11px] text-slate-400 font-mono">
        Architected in the HugoBlox Academic CV tradition &bull; Built with Astro &amp; Tailwind CSS
      </p>
    </div>
  </div>
</footer>

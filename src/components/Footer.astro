---
import resume from '../data/resume.json';

const { email, name } = resume.basics;
---
<footer class="mt-auto w-full border-t border-slate-800 bg-slate-950/80 py-12 px-4 text-center sm:px-6 backdrop-blur-sm">
  <div class="mx-auto max-w-xl flex flex-col items-center">
    <!-- Get In Touch Heading -->
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
      Get In Touch
    </h2>

    <p class="mt-3 text-sm sm:text-base text-slate-400 max-w-md leading-relaxed">
      Whether you're looking to discuss a full-time role, a software project, or an engineering collaboration, my inbox is always open.
    </p>

    <!-- Mailto link styled as a prominent primary button -->
    <div class="mt-6">
      <a
        href={`mailto:${email}`}
        class="inline-flex items-center gap-2.5 rounded-xl bg-cyan-500 px-7 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-cyan-500/25 transition-all duration-200 hover:bg-cyan-400 hover:shadow-cyan-500/40 hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Say Hello ({email})</span>
      </a>
    </div>

    <!-- Subtle social icons (GitHub, LinkedIn) side-by-side -->
    <div class="mt-8 flex items-center justify-center gap-4">
      <!-- GitHub -->
      <a
        href="https://github.com/Zafff-e"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="flex size-10 items-center justify-center rounded-lg border border-slate-800 bg-slate-900/60 text-slate-400 transition hover:border-slate-700 hover:bg-slate-800 hover:text-white"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/zafir-hasan-developer"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn Profile"
        class="flex size-10 items-center justify-center rounded-lg border border-slate-800 bg-slate-900/60 text-slate-400 transition hover:border-slate-700 hover:bg-slate-800 hover:text-white"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.761-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
        </svg>
      </a>
    </div>

    <!-- Copyright -->
    <p class="mt-8 text-xs text-slate-500">
      © {new Date().getFullYear()} {name}. Built with Astro & Tailwind CSS.
    </p>
  </div>
</footer>

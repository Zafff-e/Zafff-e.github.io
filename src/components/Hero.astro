---
import resume from '../data/resume.json';

const { name, email } = resume.basics;
const resumeUrl = "/resume.pdf";
---
<section id="about" class="py-8 sm:py-12 border-b border-slate-800/80">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    
    <!-- LEFT COLUMN: HugoBlox Academic Author Card -->
    <div class="lg:col-span-5 flex flex-col items-center lg:items-start text-center lg:text-left">
      <div class="w-full rounded-2xl border border-slate-800 bg-slate-900 p-6 sm:p-7 relative overflow-hidden">
        <!-- Subtle Top Accent Line -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500"></div>

        <div class="flex flex-col items-center">
          <!-- Portrait Avatar -->
          <div class="relative mb-5">
            <img
              src="/profile.png"
              alt={name}
              width="180"
              height="180"
              class="size-36 sm:size-40 rounded-full object-cover ring-2 ring-slate-700 bg-slate-950"
            />
            <!-- Availability Badge -->
            <span class="absolute bottom-1 right-2 inline-flex rounded-full size-3.5 bg-emerald-500 ring-2 ring-slate-900" title="Active & Open to Roles"></span>
          </div>

          <!-- Name & Primary Title -->
          <h1 class="text-2xl sm:text-3xl font-display font-extrabold text-white tracking-tight">
            {name}
          </h1>
          <p class="mt-1 text-sm font-semibold text-cyan-400 font-mono">
            Full-Stack .NET &amp; Web Developer
          </p>

          <!-- Status Badge -->
          <div class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-3 py-1 text-xs font-medium text-cyan-300">
            <span class="size-1.5 rounded-full bg-cyan-400"></span>
            <span>IsDB-BISEW IT Scholar &bull; Round 70</span>
          </div>

          <!-- Academic & Institutional Affiliations -->
          <div class="mt-5 w-full space-y-2 text-xs text-slate-300 border-t border-b border-slate-800/80 py-4">
            <div class="flex items-center gap-2.5">
              <span class="text-slate-400 text-sm">🏢</span>
              <span>Star Computer Systems Limited (SCSL)</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-slate-400 text-sm">🏛️</span>
              <span>University of Dhaka (Economics &amp; Stats)</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-slate-400 text-sm">📍</span>
              <span>Dhaka, Bangladesh</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-slate-400 text-sm">🎓</span>
              <span>IELTS Band 7.5 (CEFR C1 Proficient)</span>
            </div>
          </div>

          <!-- Quick Social & Academic Action Icons -->
          <div class="mt-5 flex flex-wrap justify-center gap-2.5">
            <!-- Email -->
            <a
              href={`mailto:${email}`}
              class="flex size-9 items-center justify-center rounded-lg border border-slate-800 bg-slate-950/80 text-slate-400 hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-400 transition shadow-sm"
              aria-label="Send Email"
              title={`Email: ${email}`}
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>

            <!-- GitHub -->
            <a
              href="https://github.com/Zafff-e"
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-9 items-center justify-center rounded-lg border border-slate-800 bg-slate-950/80 text-slate-400 hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-400 transition shadow-sm"
              aria-label="GitHub Profile"
              title="GitHub Profile"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
              </svg>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://www.linkedin.com/in/zafir-hasan-developer"
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-9 items-center justify-center rounded-lg border border-slate-800 bg-slate-950/80 text-slate-400 hover:border-cyan-500/50 hover:bg-slate-800 hover:text-cyan-400 transition shadow-sm"
              aria-label="LinkedIn Profile"
              title="LinkedIn Profile"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.761-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
              </svg>
            </a>

            <!-- Google Play Store -->
            <a
              href="https://play.google.com/store/apps/details?id=com.polin.kawser.candela&hl=en"
              target="_blank"
              rel="noopener noreferrer"
              class="flex size-9 items-center justify-center rounded-lg border border-slate-800 bg-slate-950/80 text-slate-400 hover:border-emerald-500/50 hover:bg-slate-800 hover:text-emerald-400 transition shadow-sm"
              aria-label="Google Play Store App"
              title="Google Play Store: Candela App (10K+ Installs)"
            >
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.793 12 3.61 22.186a1.996 1.996 0 0 1-1.61-.406A1.996 1.996 0 0 1 1.5 20.31V3.69c0-.575.18-1.096.5-1.47a1.996 1.996 0 0 1 1.609-.406zm11.605 11.605l2.457 2.458-12.72 7.344 10.263-9.802zm0-2.838L4.951.78l12.72 7.344-2.457 2.457zm1.414 1.419l3.654 2.11a1.998 1.998 0 0 0 0-3.46l-3.654 2.11z"/>
              </svg>
            </a>

            <!-- Download CV PDF -->
            <a
              href={resumeUrl}
              download="AHM_Zafir_Hasan_Resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-lg border border-slate-700 bg-slate-800/80 px-3 py-1.5 text-xs font-semibold text-slate-200 hover:border-cyan-500/50 hover:bg-slate-700 hover:text-white transition"
              title="Download 1-Page ATS Academic Resume"
            >
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>CV (PDF)</span>
            </a>
          </div>

          <!-- Academic & Impact Metrics Pill Bar -->
          <div class="mt-6 grid grid-cols-3 gap-2 w-full text-center">
            <div class="rounded-xl border border-slate-800/80 bg-slate-950/60 p-2">
              <span class="block text-sm sm:text-base font-extrabold text-cyan-400 font-mono">1,000+</span>
              <span class="text-[10px] text-slate-400 font-medium">Dev Hours</span>
            </div>
            <div class="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-2">
              <span class="block text-sm sm:text-base font-extrabold text-emerald-400 font-mono">10K+</span>
              <span class="text-[10px] text-emerald-300 font-medium">Play Installs</span>
            </div>
            <div class="rounded-xl border border-slate-800/80 bg-slate-950/60 p-2">
              <span class="block text-sm sm:text-base font-extrabold text-blue-400 font-mono">8+</span>
              <span class="text-[10px] text-slate-400 font-medium">Repos</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: HugoBlox Academic Living Dossier & Focus Areas -->
    <div class="lg:col-span-7 space-y-8">
      
      <!-- Biography Block -->
      <div class="space-y-4">
        <div class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-cyan-400">
          <span class="size-1.5 rounded-full bg-cyan-400"></span>
          Academic Dossier &bull; Living Portfolio
        </div>

        <h2 class="text-3xl sm:text-4xl font-display font-extrabold text-white tracking-tight">
          Engineering Enterprise Systems with Rigor &amp; Analytical Precision
        </h2>

        <div class="prose prose-invert text-slate-300 text-sm sm:text-base leading-relaxed space-y-3.5">
          <p>
            I am a full-stack software engineer trained through the prestigious <strong>IsDB-BISEW IT Scholarship Programme</strong> (Round 70, Trainee ID: <code class="text-cyan-300 font-mono text-xs bg-slate-900 px-1.5 py-0.5 rounded border border-slate-800">1294926</code>), specializing in the <strong>Microsoft .NET 9</strong> ecosystem, scalable <strong>RESTful Web APIs</strong>, and relational &amp; document database architectures.
          </p>
          <p>
            My academic foundation in <strong>Economics from the University of Dhaka</strong> provides a quantitative and econometrics perspective that directly informs how I approach data modeling, 3NF schema normalization, API throughput, and system architecture. Currently, I serve as the <strong>backend and database lead</strong> for our Agile capstone project, designing booking orchestration APIs, sprint branching workflows, and automated test pipelines.
          </p>
        </div>
      </div>

      <!-- Core Focus & Research Interests (HugoBlox "Interests" Block) -->
      <div id="focus" class="pt-2">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-3.5 flex items-center gap-2">
          <span>🎯</span>
          <span>Core Engineering Focus &amp; Interests</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-cyan-400 text-lg">⚡</span>
              <div>
                <h4 class="text-xs font-bold text-white">Enterprise .NET &amp; Web APIs</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">ASP.NET Core (.NET 9), Minimal APIs, EF Core, DTO contracts, JWT &amp; OWIN OAuth.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-cyan-400 text-lg">🗄️</span>
              <div>
                <h4 class="text-xs font-bold text-white">Database Engineering &amp; 3NF</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">SQL Server, Stored Procedures, Table-Valued Parameters (TVPs), MongoDB, Mongoose.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-cyan-400 text-lg">🌐</span>
              <div>
                <h4 class="text-xs font-bold text-white">Single Page Applications (SPAs)</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">React 19 &amp; Angular (Standalone), Vite, TypeScript, responsive Tailwind CSS layouts.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-cyan-400 text-lg">🔄</span>
              <div>
                <h4 class="text-xs font-bold text-white">Real-Time Duplex Communication</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">WebSockets bi-directional pipelines, live inventory sync, event notifications without polling.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-emerald-400 text-lg">💻</span>
              <div>
                <h4 class="text-xs font-bold text-white">Hardware Repair &amp; Diagnostics</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">Lifelong gamer &amp; hardware enthusiast. Complete repair, fault diagnosis, component replacement &amp; custom tuning for any laptop or desktop.</p>
              </div>
            </div>
          </div>

          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-3.5 transition hover:border-slate-700 hover:bg-slate-900/80">
            <div class="flex items-start gap-2.5">
              <span class="text-blue-400 text-lg">👨‍🏫</span>
              <div>
                <h4 class="text-xs font-bold text-white">HSC ICT Academic Pedagogy</h4>
                <p class="text-[11px] text-slate-400 mt-0.5">Taught national HSC ICT syllabus to college students for years: C programming logic, SQL databases, digital gates, and web fundamentals.</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Academic Education Quick Snapshot -->
      <div class="pt-2">
        <h3 class="text-xs font-mono uppercase tracking-wider text-slate-400 mb-3.5 flex items-center gap-2">
          <span>🎓</span>
          <span>Education &amp; Scholarship Track</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <!-- IsDB -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-3.5">
            <span class="text-[10px] font-mono text-cyan-400 font-semibold">2026 &bull; Professional Diploma</span>
            <h4 class="text-xs font-bold text-white mt-1">Enterprise Systems Development (C# .NET)</h4>
            <p class="text-[11px] text-slate-400 mt-0.5">IsDB-BISEW IT Scholarship &bull; Star Computer Systems Ltd</p>
          </div>
          <!-- University of Dhaka -->
          <div class="rounded-xl border border-slate-800 bg-slate-900/30 p-3.5">
            <span class="text-[10px] font-mono text-blue-400 font-semibold">2014 – 2019 &bull; B.S.S. (Hons)</span>
            <h4 class="text-xs font-bold text-white mt-1">Economics &amp; Quantitative Analytics</h4>
            <p class="text-[11px] text-slate-400 mt-0.5">University of Dhaka, Bangladesh</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

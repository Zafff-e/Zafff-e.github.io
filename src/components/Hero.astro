---
import resume from '../data/resume.json';
const { name, title, summary, location, avatar, email, resumeUrl, profiles } = resume.basics;
---
<section class="grid items-center gap-10 py-16 sm:py-24 md:grid-cols-[1fr_auto]">
  <div>
    <p class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Hi, I'm</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl dark:text-white">{name}</h1>
    <h2 class="mt-2 text-xl text-slate-600 sm:text-2xl dark:text-slate-400">{title}</h2>
    <p class="mt-6 max-w-2xl leading-relaxed">{summary}</p>
    <p class="mt-3 text-sm text-slate-500">{location}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={`mailto:${email}`} class="rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-indigo-500">Contact me</a>
      <a href={resumeUrl} class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-medium hover:bg-slate-100 dark:border-slate-700 dark:hover:bg-slate-800">Download CV</a>
      {profiles.map((p) => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:text-indigo-600 dark:text-slate-400 dark:hover:text-indigo-400">{p.label} ↗</a>
      ))}
    </div>
  </div>
  <img src={avatar} alt={name} width="224" height="224"
    class="mx-auto size-44 rounded-full bg-indigo-100 object-cover ring-4 ring-indigo-200 sm:size-56 md:order-last dark:bg-slate-800 dark:ring-slate-700" />
</section>
